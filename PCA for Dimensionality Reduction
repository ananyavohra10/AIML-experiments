import pandas as pd
import numpy as np
from sklearn.decomposition import PCA
from sklearn.preprocessing import StandardScaler

# 1. Make a small numeric dataset (6 rows, 3 columns)
data = {
    "Feature1": [2.1, 2.4, 0.9, 1.2, 3.0, 3.2],
    "Feature2": [1.3, 1.8, 3.5, 3.0, 0.8, 0.6],
    "Feature3": [4.5, 4.0, 5.2, 5.0, 4.8, 4.9]
}
df = pd.DataFrame(data)

print("Original data (6 rows × 3 columns):")
print(df)
print()

# 2. Scale the data (good practice before PCA)
scaler = StandardScaler()
X_scaled = scaler.fit_transform(df)

# 3. Apply PCA to reduce to 2 components
pca = PCA(n_components=2)
X_pca = pca.fit_transform(X_scaled)

print("After PCA (reduced to 2 components):")
print(pd.DataFrame(X_pca, columns=["PC1", "PC2"]))
print()

print("Explained variance ratio:")
print(pca.explained_variance_ratio_)
